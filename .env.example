# Copy this file to .env and put a real key in it. .env is gitignored.
#
#     cp .env.example .env
#
# The key is read fresh on every call, so the upload server picks up a new one
# without being restarted -- save the file, reload the page.
#
# Get a key at https://build.nvidia.com (Build with this NIM -> Get API Key).
NVIDIA_API_KEY=nvapi-replace-me

# Optional. Defaults to meta/llama-3.3-70b-instruct.
# The 8B model does the text-location job just as well and is far faster
# (~1.5s a call against ~20-200s), which matters if you are demonstrating this.
# PROTOCOLQC_AI_MODEL=meta/llama-3.1-8b-instruct

# Optional. Seconds per call, and retries after a failure. A hosted endpoint can
# take minutes to bring a cold model up; these bound how long it is waited on.
# PROTOCOLQC_AI_TIMEOUT=120
# PROTOCOLQC_AI_RETRIES=1

# Optional. Point at a self-hosted NIM instead of the public endpoint.
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
