# Copy this file to .env and put a real key in it. .env is gitignored.
#
#     cp .env.example .env
#
# The key is read fresh on every call, so the upload server picks up a new one
# without being restarted -- save the file, reload the page.
#
# Get a key at https://build.nvidia.com (Build with this NIM -> Get API Key).
NVIDIA_API_KEY=nvapi-replace-me

# Optional. Defaults to meta/llama-3.3-70b-instruct.
# PROTOCOLQC_AI_MODEL=meta/llama-3.3-70b-instruct

# Optional. Point at a self-hosted NIM instead of the public endpoint.
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
